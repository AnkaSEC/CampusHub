# PostgreSQL (Neon / Supabase / Railway önerilir)
DB_URL=jdbc:postgresql://HOST/neondb?sslmode=require
DB_USERNAME=neondb_owner
DB_PASSWORD=your_db_password
DB_POOL_SIZE=5

# JWT (en az 32 karakter)
JWT_SECRET=replace_with_a_long_random_secret_key_32plus

# CORS — mobil native için * yeterli; web için domain listesi
CORS_ALLOWED_ORIGINS=*

# Firebase (serviceAccountKey.json içeriğini tek satır JSON olarak yapıştır)
FIREBASE_STORAGE_BUCKET=campushub-67b2b.appspot.com
FIREBASE_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}

# Opsiyonel
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false
