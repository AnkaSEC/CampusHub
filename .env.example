# Supabase PostgreSQL
# Dashboard → Project Settings → Database → Connection string → URI
# JDBC formatına çevir: postgresql:// → jdbc:postgresql://
# Session mode (5432) veya Transaction pooler (6543) kullanabilirsin

DB_URL=jdbc:postgresql://db.lzliqcvigymrgdrqeeqb.supabase.co:5432/postgres?sslmode=require
DB_USERNAME=postgres
DB_PASSWORD=1DwmMlzLQeUv9hZg
DB_POOL_SIZE=5

# JWT (en az 32 karakter)
JWT_SECRET=replace_with_a_long_random_secret_key_32plus

# CORS — mobil native için * yeterli
CORS_ALLOWED_ORIGINS=*

# Firebase (serviceAccountKey.json içeriğini tek satır JSON)
FIREBASE_STORAGE_BUCKET=campushub-67b2b.appspot.com
FIREBASE_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}

# Opsiyonel
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false
