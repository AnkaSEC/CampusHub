# Lokal çalıştırma: IDE Run Configuration env olarak ekle
# veya PowerShell'de set edip mvnw spring-boot:run çalıştır

# Supabase → Connect → Session pooler (IPv4) — Render için ZORUNLU
DB_URL=jdbc:postgresql://aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
DB_USERNAME=postgres.YOUR_PROJECT_REF
DB_PASSWORD=your_supabase_db_password
DB_POOL_SIZE=5

JWT_SECRET=replace_with_a_long_random_secret_key_32plus
CORS_ALLOWED_ORIGINS=*
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false

FIREBASE_STORAGE_BUCKET=campushub-67b2b.appspot.com
FIREBASE_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}
